# Django Settings
DEBUG=0
SECRET_KEY=your-secret-key
# Public hostnames. Comma-separated. Do not use *.
ALLOWED_HOSTS=venue-tracker.com,localhost,127.0.0.1

# Database Settings
# Production compose reads POSTGRES_PASSWORD from this file. The existing
# database volume keeps whatever password it was first created with.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=venue_tracker
DATABASE_URL=postgres://postgres:change-me@db:5432/venue_tracker

# Email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# OpenAI API Settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_COMPLETION_TOKENS=8000

# Browser origins allowed to call the API. Comma-separated.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://venue-tracker.com,http://localhost:3000

# API address the frontend calls. Set this to the public API origin.
REACT_APP_API_URL=https://venue-tracker.com/api
REACT_APP_BACKEND_HOST=venue-tracker.com

# Docker Environment Settings
# Development Mode (hot reloading)
FRONTEND_DOCKERFILE=Dockerfile.dev
FRONTEND_COMMAND=npm start
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# Production Mode (uncomment to switch)
# FRONTEND_DOCKERFILE=Dockerfile.frontend
# FRONTEND_COMMAND=serve -s build -l 3000 